{
  "name": "colorgirl",
  "version": "1.2.7",
  "type": "module",
  "bin": {
    "colorgirl": "./dist/cli/app.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/app.tsx",
    "worker": "tsx src/temporal/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.90",
    "@temporalio/activity": "^1.11.7",
    "@temporalio/client": "^1.11.7",
    "@temporalio/worker": "^1.11.7",
    "@temporalio/workflow": "^1.11.7",
    "axios": "^1.14.0",
    "cheerio": "^1.2.0",
    "csv-stringify": "^6.5.2",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.11.7",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.23",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "optionalDependencies": {
    "playwright": "^1.52.0"
  }
}
