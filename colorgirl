#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker/docker-compose.yml"
TOKEN_REFRESHER_PID=""

# ---------------------------------------------------------------------------
# OAuth token refresh (like logan's pattern)
# ---------------------------------------------------------------------------

# Find the credentials file once
find_cred_file() {
  for candidate in "$HOME/.claude/.credentials.json" "${USERPROFILE:-}/.claude/.credentials.json"; do
    if [ -f "$candidate" ]; then
      echo "$candidate"
      return
    fi
  done
}

# Read token from credentials file
read_token_from_file() {
  local cred_file="$1"
  node -e "var fs=require('fs');try{var d=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));console.log(d.claudeAiOauth.accessToken)}catch(e){process.exit(1)}" "$cred_file" 2>/dev/null || true
}

# Refresh OAuth token by running claude --print "ping" (forces token refresh in credentials file)
refresh_oauth_token() {
  local cred_file
  cred_file="$(find_cred_file)"
  if [ -z "$cred_file" ] || [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    return  # Using API key or no cred file — nothing to refresh
  fi

  # Run claude --print to trigger token refresh in the credentials file
  docker run --rm \
    -e CLAUDE_CODE_OAUTH_TOKEN="${CLAUDE_CODE_OAUTH_TOKEN}" \
    docker-colorgirl-worker \
    claude --print "ping" > /dev/null 2>&1 || true

  # Re-read the refreshed token
  local new_token
  new_token="$(read_token_from_file "$cred_file")"
  if [ -n "$new_token" ]; then
    export CLAUDE_CODE_OAUTH_TOKEN="$new_token"
    # Update running worker container's env by recreating it
    docker compose -f "$COMPOSE_FILE" up -d colorgirl-worker > /dev/null 2>&1 || true
  fi
}

# Background token refresher — runs every 45 minutes
start_token_refresher() {
  if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    return  # Using API key — no refresh needed
  fi
  (
    while true; do
      sleep 2700  # 45 minutes
      refresh_oauth_token
    done
  ) &
  TOKEN_REFRESHER_PID=$!
}

stop_token_refresher() {
  if [ -n "$TOKEN_REFRESHER_PID" ]; then
    kill "$TOKEN_REFRESHER_PID" 2>/dev/null || true
    wait "$TOKEN_REFRESHER_PID" 2>/dev/null || true
  fi
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
  cat <<'EOF'
Usage: ./colorgirl [OPTIONS]

  Scrape supplier products and generate WooCommerce CSV imports.

Options:
  --verbose, -v    Show build output and worker logs
  --stop           Tear down all containers
  --rebuild        Force Docker rebuild (no cache)
  --help, -h       Show this help

Examples:
  ./colorgirl                  Start everything, launch interactive TUI
  ./colorgirl -v               Same but see build + worker logs
  ./colorgirl --stop           Tear down containers
  ./colorgirl --rebuild        Rebuild Docker images from scratch
EOF
}

# ---------------------------------------------------------------------------
# Parse flags
# ---------------------------------------------------------------------------

VERBOSE=false
STOP=false
REBUILD=false

for arg in "$@"; do
  case "$arg" in
    --verbose|-v) VERBOSE=true ;;
    --stop)       STOP=true ;;
    --rebuild)    REBUILD=true ;;
    --help|-h)    usage; exit 0 ;;
    *)            echo "Unknown option: $arg"; usage; exit 1 ;;
  esac
done

# ---------------------------------------------------------------------------
# Check prerequisites
# ---------------------------------------------------------------------------

check_docker() {
  if command -v docker &>/dev/null && docker info >/dev/null 2>&1; then
    return 0
  fi

  echo "Docker is not installed or not running."
  echo ""

  case "$(uname -s)" in
    Darwin)
      echo "Install Docker Desktop for Mac:"
      if command -v brew &>/dev/null; then
        read -rp "Install via Homebrew? [Y/n] " yn
        case "${yn:-Y}" in
          [Yy]*|"")
            brew install --cask docker
            echo "Docker Desktop installed. Please open it from Applications and wait for it to start."
            echo "Then re-run ./colorgirl"
            exit 0
            ;;
        esac
      fi
      echo "  https://docs.docker.com/desktop/install/mac-install/"
      ;;
    Linux)
      echo "Install Docker Engine:"
      if command -v apt-get &>/dev/null; then
        read -rp "Install via apt? [Y/n] " yn
        case "${yn:-Y}" in
          [Yy]*|"")
            curl -fsSL https://get.docker.com | sh
            sudo usermod -aG docker "$USER"
            echo "Docker installed. You may need to log out and back in for group changes."
            echo "Then re-run ./colorgirl"
            exit 0
            ;;
        esac
      elif command -v dnf &>/dev/null; then
        read -rp "Install via dnf? [Y/n] " yn
        case "${yn:-Y}" in
          [Yy]*|"")
            sudo dnf install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
            sudo systemctl start docker
            sudo usermod -aG docker "$USER"
            echo "Docker installed. You may need to log out and back in for group changes."
            echo "Then re-run ./colorgirl"
            exit 0
            ;;
        esac
      fi
      echo "  https://docs.docker.com/engine/install/"
      ;;
    MINGW*|MSYS*|CYGWIN*)
      echo "Install Docker Desktop for Windows:"
      if command -v winget &>/dev/null; then
        read -rp "Install via winget? [Y/n] " yn
        case "${yn:-Y}" in
          [Yy]*|"")
            winget install -e --id Docker.DockerDesktop
            echo "Docker Desktop installed. Please open it and wait for it to start."
            echo "Then re-run ./colorgirl"
            exit 0
            ;;
        esac
      fi
      echo "  https://docs.docker.com/desktop/install/windows-install/"
      ;;
    *)
      echo "  https://docs.docker.com/get-docker/"
      ;;
  esac

  exit 1
}

check_node() {
  if command -v node &>/dev/null; then
    return 0
  fi

  echo "Node.js is not installed."
  echo ""

  case "$(uname -s)" in
    Darwin)
      if command -v brew &>/dev/null; then
        read -rp "Install via Homebrew? [Y/n] " yn
        case "${yn:-Y}" in
          [Yy]*|"") brew install node@20; exit 0 ;;
        esac
      fi
      echo "  https://nodejs.org/en/download/"
      ;;
    Linux)
      echo "Install via package manager or:"
      echo "  curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash -"
      echo "  sudo apt-get install -y nodejs"
      ;;
    MINGW*|MSYS*|CYGWIN*)
      if command -v winget &>/dev/null; then
        read -rp "Install via winget? [Y/n] " yn
        case "${yn:-Y}" in
          [Yy]*|"") winget install -e --id OpenJS.NodeJS.LTS; exit 0 ;;
        esac
      fi
      echo "  https://nodejs.org/en/download/"
      ;;
    *)
      echo "  https://nodejs.org/en/download/"
      ;;
  esac

  exit 1
}

check_docker
check_node

# ---------------------------------------------------------------------------
# Handle --stop
# ---------------------------------------------------------------------------

if $STOP; then
  echo "Stopping colorgirl containers..."
  docker compose -f "$COMPOSE_FILE" down
  echo "Done."
  exit 0
fi

# ---------------------------------------------------------------------------
# 1. Resolve credentials (interactive)
# ---------------------------------------------------------------------------

if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -z "${ANTHROPIC_API_KEY:-}" ]; then
  # Try auto-import from Claude Code
  CRED_FILE="$(find_cred_file)"
  AUTO_TOKEN=""
  if [ -n "$CRED_FILE" ]; then
    AUTO_TOKEN="$(read_token_from_file "$CRED_FILE")"
  fi

  if [ -n "${AUTO_TOKEN:-}" ]; then
    echo "Found Claude Code credentials."
    echo ""
    echo "  [1] Use Claude Code login (auto-detected)"
    echo "  [2] Paste an Anthropic API key instead"
    echo ""
    read -rp "Choice [1]: " cred_choice
    case "${cred_choice:-1}" in
      1|"")
        export CLAUDE_CODE_OAUTH_TOKEN="$AUTO_TOKEN"
        echo "Using Claude Code OAuth token."
        ;;
      2)
        read -rp "Anthropic API key: " api_key
        if [ -z "$api_key" ]; then
          echo "ERROR: No API key provided."
          exit 1
        fi
        export ANTHROPIC_API_KEY="$api_key"
        echo "Using API key."
        ;;
      *)
        echo "Invalid choice."
        exit 1
        ;;
    esac
  else
    # No auto-import available
    echo "No Claude Code credentials found."
    echo ""
    echo "  [1] Paste an Anthropic API key"
    echo "  [2] Paste a Claude Code OAuth token"
    echo ""
    echo "  (To auto-detect: install Claude Code and run 'claude' to log in)"
    echo ""
    read -rp "Choice [1]: " cred_choice
    case "${cred_choice:-1}" in
      1|"")
        read -rp "Anthropic API key: " api_key
        if [ -z "$api_key" ]; then
          echo "ERROR: No API key provided."
          exit 1
        fi
        export ANTHROPIC_API_KEY="$api_key"
        echo "Using API key."
        ;;
      2)
        read -rp "OAuth token: " oauth_token
        if [ -z "$oauth_token" ]; then
          echo "ERROR: No token provided."
          exit 1
        fi
        export CLAUDE_CODE_OAUTH_TOKEN="$oauth_token"
        echo "Using OAuth token."
        ;;
      *)
        echo "Invalid choice."
        exit 1
        ;;
    esac
  fi
fi

export CLAUDE_CODE_OAUTH_TOKEN="${CLAUDE_CODE_OAUTH_TOKEN:-}"
export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"
if $VERBOSE; then
  export COLORGIRL_VERBOSE=1
fi

# ---------------------------------------------------------------------------
# 2. Validate credentials before spinning up infrastructure
# ---------------------------------------------------------------------------

echo ""

# Build the worker image (needed for credential check and running)
echo "Building worker image..."
if $VERBOSE; then
  docker compose -f "$COMPOSE_FILE" build colorgirl-worker 2>&1
else
  docker compose -f "$COMPOSE_FILE" build colorgirl-worker > /dev/null 2>&1
fi

echo -n "Validating credentials..."

# First attempt
PING_RESULT=$(docker run --rm \
  -e CLAUDE_CODE_OAUTH_TOKEN="${CLAUDE_CODE_OAUTH_TOKEN:-}" \
  -e ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}" \
  docker-colorgirl-worker \
  claude --print "respond with exactly: ok" 2>&1) || true

if echo "$PING_RESULT" | grep -qi "expired"; then
  # Token expired — try refreshing via claude CLI (like logan does)
  echo " token expired, refreshing..."
  CRED_FILE="$(find_cred_file)"
  if [ -n "$CRED_FILE" ]; then
    # Run claude --print to trigger refresh in credentials file
    docker run --rm \
      -e CLAUDE_CODE_OAUTH_TOKEN="${CLAUDE_CODE_OAUTH_TOKEN:-}" \
      docker-colorgirl-worker \
      claude --print "ping" > /dev/null 2>&1 || true

    # Re-read refreshed token
    NEW_TOKEN="$(read_token_from_file "$CRED_FILE")"
    if [ -n "$NEW_TOKEN" ] && [ "$NEW_TOKEN" != "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
      export CLAUDE_CODE_OAUTH_TOKEN="$NEW_TOKEN"
      echo -n "  Retrying with refreshed token..."

      PING_RESULT=$(docker run --rm \
        -e CLAUDE_CODE_OAUTH_TOKEN="$NEW_TOKEN" \
        docker-colorgirl-worker \
        claude --print "respond with exactly: ok" 2>&1) || true
    fi
  fi
fi

if echo "$PING_RESULT" | grep -qi "ok"; then
  echo " valid."
elif echo "$PING_RESULT" | grep -qi "expired\|authentication_error\|401\|unauthorized"; then
  echo ""
  echo "ERROR: Authentication failed."
  echo ""
  echo "Fix: run 'claude' to re-authenticate, then re-run ./colorgirl"
  echo "  Or pass an API key: ANTHROPIC_API_KEY=sk-ant-... ./colorgirl"
  if $VERBOSE; then
    echo "Detail: $PING_RESULT"
  fi
  exit 1
else
  echo " unknown response (proceeding anyway)."
  if $VERBOSE; then
    echo "Ping response: $PING_RESULT"
  fi
fi

# ---------------------------------------------------------------------------
# 3. Start Docker containers (fresh, so env vars are up to date)
# ---------------------------------------------------------------------------

# Always recreate containers to pick up fresh credentials
docker compose -f "$COMPOSE_FILE" down > /dev/null 2>&1 || true

echo "Starting infrastructure..."

if $REBUILD; then
  echo "Rebuilding Docker images (no cache)..."
  if $VERBOSE; then
    docker compose -f "$COMPOSE_FILE" build --no-cache 2>&1
  else
    docker compose -f "$COMPOSE_FILE" build --no-cache > /dev/null 2>&1
  fi
fi

if $VERBOSE; then
  docker compose -f "$COMPOSE_FILE" up -d --build 2>&1 | grep -v "^$"
else
  # Suppress stdout but show errors
  docker compose -f "$COMPOSE_FILE" up -d --build > /dev/null 2>&1
  if [ $? -ne 0 ]; then
    echo "ERROR: Docker failed to start. Re-run with --verbose for details."
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# 3. Wait for Temporal to be ready
# ---------------------------------------------------------------------------

echo -n "Waiting for Temporal"
TEMPORAL_READY=false
for i in $(seq 1 60); do
  if curl -sf http://localhost:8080/api/v1/namespaces/default &>/dev/null; then
    TEMPORAL_READY=true
    break
  fi
  echo -n "."
  sleep 2
done
echo ""

if ! $TEMPORAL_READY; then
  echo "ERROR: Temporal failed to start within 120 seconds."
  echo "Check logs: docker compose -f $COMPOSE_FILE logs temporal"
  exit 1
fi

echo "Temporal ready."

# Wait for worker to connect (it may restart a few times while Temporal initialises)
echo -n "Waiting for worker"
WORKER_READY=false
for i in $(seq 1 30); do
  if docker compose -f "$COMPOSE_FILE" ps --status running 2>/dev/null | grep -q colorgirl-worker; then
    WORKER_READY=true
    break
  fi
  echo -n "."
  sleep 3
done
echo ""

if ! $WORKER_READY; then
  echo "ERROR: Worker failed to start."
  docker compose -f "$COMPOSE_FILE" logs --tail 20 colorgirl-worker
  exit 1
fi

echo "Worker connected."

# Start background token refresher (every 45 min, like logan)
start_token_refresher

# Cleanup on exit (any exit — success, error, or Ctrl+C)
cleanup() {
  local exit_code=$?
  echo ""
  stop_token_refresher
  echo "Stopping containers..."
  docker compose -f "$COMPOSE_FILE" down 2>/dev/null || true
  echo "Cleaned up."
  exit $exit_code
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------------
# 4. Build TUI locally and run
# ---------------------------------------------------------------------------

echo ""
# Run TUI inside a container from the worker image (no local Node/npm required).
# Uses the same Docker network so it can reach the Temporal server.
COMPOSE_PROJECT="$(basename "$(dirname "$COMPOSE_FILE")")"
docker run -it --rm \
  --network "${COMPOSE_PROJECT}_default" \
  -e TEMPORAL_ADDRESS=temporal:7233 \
  -e CLAUDE_CODE_OAUTH_TOKEN="${CLAUDE_CODE_OAUTH_TOKEN:-}" \
  -e ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}" \
  -e COLORTERM=truecolor \
  -e FORCE_COLOR=3 \
  -e COLORGIRL_VERBOSE="${COLORGIRL_VERBOSE:-0}" \
  docker-colorgirl-worker \
  node dist/cli/app.js
