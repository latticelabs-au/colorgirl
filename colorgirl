#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker/docker-compose.yml"

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
  cat <<'EOF'
Usage: ./colorgirl [OPTIONS]

  Scrape supplier products and generate WooCommerce CSV imports.

Options:
  --verbose, -v    Show worker logs (Opus agent activity)
  --stop           Tear down all containers
  --rebuild        Force Docker rebuild (no cache)
  --help, -h       Show this help

Credentials:
  Auto-reads OAuth token from ~/.claude/.credentials.json (Claude Code login).
  Or set ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN in environment.

Examples:
  ./colorgirl                  Start everything, launch interactive TUI
  ./colorgirl -v               Same but see Opus/worker logs
  ./colorgirl --stop           Tear down containers
  ./colorgirl --rebuild        Rebuild Docker images from scratch
EOF
}

# ---------------------------------------------------------------------------
# Parse flags
# ---------------------------------------------------------------------------

VERBOSE=false
STOP=false
REBUILD=false

for arg in "$@"; do
  case "$arg" in
    --verbose|-v) VERBOSE=true ;;
    --stop)       STOP=true ;;
    --rebuild)    REBUILD=true ;;
    --help|-h)    usage; exit 0 ;;
    *)            echo "Unknown option: $arg"; usage; exit 1 ;;
  esac
done

# ---------------------------------------------------------------------------
# Check prerequisites
# ---------------------------------------------------------------------------

check_docker() {
  if command -v docker &>/dev/null && docker info &>/dev/null 2>&1; then
    return 0
  fi

  echo "Docker is not installed or not running."
  echo ""

  # Detect platform and offer install
  case "$(uname -s)" in
    Darwin)
      echo "Install Docker Desktop for Mac:"
      if command -v brew &>/dev/null; then
        read -rp "Install via Homebrew? [Y/n] " yn
        case "${yn:-Y}" in
          [Yy]*|"")
            brew install --cask docker
            echo "Docker Desktop installed. Please open it from Applications and wait for it to start."
            echo "Then re-run ./colorgirl"
            exit 0
            ;;
        esac
      fi
      echo "  https://docs.docker.com/desktop/install/mac-install/"
      ;;
    Linux)
      echo "Install Docker Engine:"
      if command -v apt-get &>/dev/null; then
        read -rp "Install via apt? [Y/n] " yn
        case "${yn:-Y}" in
          [Yy]*|"")
            curl -fsSL https://get.docker.com | sh
            sudo usermod -aG docker "$USER"
            echo "Docker installed. You may need to log out and back in for group changes."
            echo "Then re-run ./colorgirl"
            exit 0
            ;;
        esac
      elif command -v dnf &>/dev/null; then
        read -rp "Install via dnf? [Y/n] " yn
        case "${yn:-Y}" in
          [Yy]*|"")
            sudo dnf install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
            sudo systemctl start docker
            sudo usermod -aG docker "$USER"
            echo "Docker installed. You may need to log out and back in for group changes."
            echo "Then re-run ./colorgirl"
            exit 0
            ;;
        esac
      fi
      echo "  https://docs.docker.com/engine/install/"
      ;;
    MINGW*|MSYS*|CYGWIN*)
      echo "Install Docker Desktop for Windows:"
      if command -v winget &>/dev/null; then
        read -rp "Install via winget? [Y/n] " yn
        case "${yn:-Y}" in
          [Yy]*|"")
            winget install -e --id Docker.DockerDesktop
            echo "Docker Desktop installed. Please open it and wait for it to start."
            echo "Then re-run ./colorgirl"
            exit 0
            ;;
        esac
      fi
      echo "  https://docs.docker.com/desktop/install/windows-install/"
      ;;
    *)
      echo "  https://docs.docker.com/get-docker/"
      ;;
  esac

  exit 1
}

check_node() {
  if command -v node &>/dev/null; then
    return 0
  fi

  echo "Node.js is not installed."
  echo ""

  case "$(uname -s)" in
    Darwin)
      if command -v brew &>/dev/null; then
        read -rp "Install via Homebrew? [Y/n] " yn
        case "${yn:-Y}" in
          [Yy]*|"") brew install node@20; exit 0 ;;
        esac
      fi
      echo "  https://nodejs.org/en/download/"
      ;;
    Linux)
      echo "Install via package manager or:"
      echo "  curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash -"
      echo "  sudo apt-get install -y nodejs"
      ;;
    MINGW*|MSYS*|CYGWIN*)
      if command -v winget &>/dev/null; then
        read -rp "Install via winget? [Y/n] " yn
        case "${yn:-Y}" in
          [Yy]*|"") winget install -e --id OpenJS.NodeJS.LTS; exit 0 ;;
        esac
      fi
      echo "  https://nodejs.org/en/download/"
      ;;
    *)
      echo "  https://nodejs.org/en/download/"
      ;;
  esac

  exit 1
}

check_docker
check_node

# ---------------------------------------------------------------------------
# Handle --stop
# ---------------------------------------------------------------------------

if $STOP; then
  echo "Stopping colorgirl containers..."
  docker compose -f "$COMPOSE_FILE" down
  echo "Done."
  exit 0
fi

# ---------------------------------------------------------------------------
# 1. Resolve credentials
# ---------------------------------------------------------------------------

if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -z "${ANTHROPIC_API_KEY:-}" ]; then
  # Find credentials file
  CRED_FILE=""
  for candidate in "$HOME/.claude/.credentials.json" "$USERPROFILE/.claude/.credentials.json"; do
    if [ -f "$candidate" ]; then
      CRED_FILE="$candidate"
      break
    fi
  done

  if [ -n "$CRED_FILE" ]; then
    TOKEN=$(node -e "var fs=require('fs');try{var d=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));console.log(d.claudeAiOauth.accessToken)}catch(e){process.exit(1)}" "$CRED_FILE" 2>/dev/null || true)
    if [ -n "${TOKEN:-}" ]; then
      export CLAUDE_CODE_OAUTH_TOKEN="$TOKEN"
      echo "Loaded OAuth token from ~/.claude/.credentials.json"
    fi
  fi

  if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo "ERROR: No credentials found."
    echo ""
    echo "Either:"
    echo "  1. Log in via Claude Code (creates ~/.claude/.credentials.json)"
    echo "  2. Set ANTHROPIC_API_KEY in your environment"
    echo "  3. Set CLAUDE_CODE_OAUTH_TOKEN in your environment"
    exit 1
  fi
fi

export CLAUDE_CODE_OAUTH_TOKEN="${CLAUDE_CODE_OAUTH_TOKEN:-}"
export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"
if $VERBOSE; then
  export COLORGIRL_VERBOSE=1
fi

# ---------------------------------------------------------------------------
# 2. Build & start Docker containers
# ---------------------------------------------------------------------------

echo "Starting colorgirl infrastructure..."

BUILD_ARGS=""
if $REBUILD; then
  BUILD_ARGS="--no-cache"
fi

docker compose -f "$COMPOSE_FILE" up -d --build $BUILD_ARGS 2>&1 | grep -v "^$"

# ---------------------------------------------------------------------------
# 3. Wait for Temporal to be ready
# ---------------------------------------------------------------------------

echo -n "Waiting for Temporal"
TEMPORAL_READY=false
for i in $(seq 1 60); do
  # Check via Temporal UI API (more reliable than CLI inside container)
  if curl -sf http://localhost:8080/api/v1/namespaces/default &>/dev/null; then
    TEMPORAL_READY=true
    break
  fi
  echo -n "."
  sleep 2
done
echo ""

if ! $TEMPORAL_READY; then
  echo "ERROR: Temporal failed to start within 120 seconds."
  echo "Check logs: docker compose -f $COMPOSE_FILE logs temporal"
  exit 1
fi

echo "Temporal ready."

# Wait a bit for worker to connect
sleep 3

# Check worker is running
if ! docker compose -f "$COMPOSE_FILE" ps --status running | grep -q colorgirl-worker; then
  echo "WARNING: Worker container not running. Checking logs..."
  docker compose -f "$COMPOSE_FILE" logs --tail 20 colorgirl-worker
  exit 1
fi

echo "Worker connected."

# ---------------------------------------------------------------------------
# 4. Verbose mode: tail worker logs in background
# ---------------------------------------------------------------------------

# Cleanup on exit (any exit — success, error, or Ctrl+C)
cleanup() {
  local exit_code=$?
  echo ""
  echo "Stopping containers..."
  docker compose -f "$COMPOSE_FILE" down 2>/dev/null || true
  echo "Cleaned up."
  exit $exit_code
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------------
# 5. Build TUI locally and run
# ---------------------------------------------------------------------------

echo "Building TUI..."
npm run build --prefix "$SCRIPT_DIR" 2>/dev/null

echo ""
echo "Launching ColorGirl..."
echo ""

node "$SCRIPT_DIR/dist/cli/app.js"
